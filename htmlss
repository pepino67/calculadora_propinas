<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Para Sofía</title>
<style>
  body{
    margin:0;
    font-family:sans-serif;
    background: linear-gradient(180deg,#fff7e6,#fff1c6);
    text-align:center;
    color:#2b2b2b;
    overflow-x:hidden;
  }
  h1{font-size:36px;margin-top:20px;color:#b86b00;}
  p{margin:10px 0 30px;}
  /* Sobre */
  #envelopeBtn{
    width:220px;height:120px;
    margin:40px auto;
    background:#fffef7;
    border:2px solid #f1c36a;
    border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 6px 20px rgba(0,0,0,0.2);
    cursor:pointer;
    transition:transform .2s;
  }
  #envelopeBtn:active{transform:scale(0.95);}
  /* Modal carta */
  #letterModal{
    position:fixed;inset:0;
    display:flex;align-items:center;justify-content:center;
    background:rgba(0,0,0,0.5);
    opacity:0;pointer-events:none;
    transition:.3s;
  }
  #letterModal.show{opacity:1;pointer-events:auto;}
  .letter{
    background:#fffdf8;padding:20px;border-radius:12px;
    max-width:350px;box-shadow:0 12px 40px rgba(0,0,0,0.3);
    position:relative;
  }
  .close{
    position:absolute;top:10px;right:14px;
    background:none;border:none;font-size:22px;cursor:pointer;
  }
  .text{font-size:16px;line-height:1.5;white-space:pre-wrap;}
  .letter button{
    margin-top:20px;padding:10px 18px;border:none;border-radius:8px;
    background:#f1c36a;color:#663b00;font-weight:600;cursor:pointer;
  }
  /* Jardín */
  #garden{
    display:none;
    margin:30px auto;max-width:350px;padding:20px;
    border-radius:16px;
    background: linear-gradient(180deg,#fffaf1,#fff1c6);
    position:relative;overflow:hidden;
  }
  #garden h2{margin:0 0 16px;color:#6a3f00;font-size:20px;}
  .lily{
    position:absolute;bottom:0;
    transform-origin:center bottom;
    animation:sway 6s ease-in-out infinite;
  }
  @keyframes sway{
    0%{transform:rotate(-2deg);}
    50%{transform:rotate(2deg);}
    100%{transform:rotate(-2deg);}
  }
  @keyframes grow{
    0%{transform: scaleY(0);}
    100%{transform: scaleY(1);}
  }
</style>
</head>
<body>
<h1>Para Sofía</h1>
<p>Un pequeño regalo — abre el sobre ❤️</p>

<div id="envelopeBtn">✉️</div>

<div id="letterModal">
  <div class="letter">
    <button class="close" id="closeLetter">✕</button>
    <div class="text" id="letterText"></div>
    <button id="showGarden">Ver mi jardín</button>
  </div>
</div>

<div id="garden">
  <h2>Un jardín lleno de lirios amarillos 🌼</h2>
  <div id="field" style="height:200px;position:relative;"></div>
  <p>Te doy una sonrisa 🩵</p>
</div>

<script>
const cartaTexto = `No te puedo dar un ramo de flores amarillas, pero sí te puedo dar una sonrisa, Sofía, eres el amor de mi vida, te amo muchísimo, ahora no puedo, pero cuando pueda te compraré el mundo entero, te amo muchísimo mi amor, espero que hoy lo pases bien, te amo mucho mi cielito lindo🩵`;

const envelopeBtn=document.getElementById('envelopeBtn');
const letterModal=document.getElementById('letterModal');
const letterText=document.getElementById('letterText');
const closeLetter=document.getElementById('closeLetter');
const showGardenBtn=document.getElementById('showGarden');
const garden=document.getElementById('garden');
const field=document.getElementById('field');

function showModal(){
  letterModal.classList.add('show');
  typeWriter(cartaTexto,letterText,15);
}
function hideModal(){letterModal.classList.remove('show');}

function typeWriter(text,node,speed=30){
  let i=0; node.innerHTML="";
  const interval=setInterval(()=>{
    node.innerHTML+=text[i];
    i++;
    if(i>=text.length) clearInterval(interval);
  },speed);
}

function showGarden(){
  hideModal();
  garden.style.display="block";
  garden.scrollIntoView({behavior:"smooth"});
  for(let i=0;i<10;i++){
    const lily=document.createElement('div');
    lily.className="lily";
    lily.style.left=(Math.random()*80)+"%";
    lily.style.width="40px";
    lily.style.bottom="0px";
    lily.innerHTML=`<div style="width:40px;height:60px;background:yellow;border-radius:50% 50% 0 0;transform-origin:center bottom;transform:scaleY(0);animation:grow 1.2s forwards;"></div>`;
    field.appendChild(lily);
  }
}

envelopeBtn.addEventListener("click", showModal);
closeLetter.addEventListener("click", hideModal);
showGardenBtn.addEventListener("click", showGarden);
</script>
</body>
</html>
